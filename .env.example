AI_EVALUATION_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_EVALUATION_API_KEY=
AI_EVALUATION_MODEL=gpt-4.1-mini
# 允许用户在“个人 API”中填写的额外域名，多个域名用逗号分隔。内置服务商无需填写。
AI_ALLOWED_ENDPOINT_HOSTS=
AI_TRANSCRIPTION_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Experimental owner-only Codex gateway. Keep both secrets server-side.
CODEX_GATEWAY_URL=
CODEX_GATEWAY_TOKEN=
CODEX_OWNER_EMAIL=
CODEX_OWNER_USER_ID=

# Authentication. Anonymous local mode is always available.
AUTH_MODE=auto
AUTH_ENABLE_CHATGPT=false
AUTH_TRUST_CHATGPT_HEADERS=false

# Trusted reverse-proxy / SSO mode. Keep the secret server-side and make the
# proxy strip any client-supplied identity headers before adding its own.
AUTH_PROXY_SECRET=
AUTH_USER_ID_HEADER=x-auth-user-id
AUTH_EMAIL_HEADER=x-auth-user-email
AUTH_NAME_HEADER=x-auth-user-name

# Only enable when every request is protected by Cloudflare Access.
AUTH_TRUST_CLOUDFLARE_ACCESS=false

# Optional sign-in pages provided by Auth.js, Supabase, Clerk or another
# identity service. Relative paths and HTTPS URLs are accepted.
AUTH_GITHUB_SIGNIN_URL=
AUTH_GOOGLE_SIGNIN_URL=
AUTH_EMAIL_SIGNIN_URL=
